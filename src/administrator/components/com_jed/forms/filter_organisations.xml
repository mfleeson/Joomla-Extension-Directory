<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" label="JSEARCH_FILTER" hint="COM_JED_ORGANISATIONS_SEARCH_HINT"/>
        <field name="state" type="list" label="JSTATUS" onchange="this.form.submit();">
            <option value="">JOPTION_SELECT_PUBLISHED</option>
            <option value="1">COM_JED_ORGANISATION_STATE_ACTIVE</option>
            <option value="0">COM_JED_ORGANISATION_STATE_DISABLED</option>
        </field>
        <field name="personal" type="list" label="COM_JED_ORGANISATION_FIELD_PERSONAL_LABEL" onchange="this.form.submit();">
            <option value="">COM_JED_ORGANISATIONS_FILTER_KIND_ALL</option>
            <option value="0">COM_JED_ORGANISATIONS_FILTER_KIND_COMPANY</option>
            <option value="1">COM_JED_ORGANISATIONS_FILTER_KIND_PERSONAL</option>
        </field>
        <field name="pending" type="list" label="COM_JED_ORGANISATIONS_FILTER_PENDING" onchange="this.form.submit();">
            <option value="">JALL</option>
            <option value="1">COM_JED_ORGANISATIONS_FILTER_PENDING_ONLY</option>
        </field>
    </fields>
    <fields name="list">
        <field name="fullordering" type="list" onchange="this.form.submit();" default="a.title ASC">
            <option value="a.title ASC">JGLOBAL_TITLE_ASC</option>
            <option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
            <option value="a.created DESC">JDATE_DESC</option>
            <option value="a.created ASC">JDATE_ASC</option>
            <option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
            <option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
        </field>
        <field name="limit" type="limitbox" default="25" onchange="this.form.submit();"/>
    </fields>
</form>
